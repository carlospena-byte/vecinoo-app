# Copy this file to .env.development and .env.production and fill in each
# environment's Supabase project values. The build picks one with
# --dart-define=ENV=development|production (default: development).
# Local dev (via `supabase start` in gates-admin): http://127.0.0.1:64321
SUPABASE_URL=http://127.0.0.1:64321
SUPABASE_PUBLISHABLE_KEY=
# Base URL of the gates-admin web app (serves the FastLane self-registration
# link at #fastlane/<code>).
PUBLIC_APP_URL=https://vecinoo.app/
